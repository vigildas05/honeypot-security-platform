# Local development defaults for the all-in-one docker-compose.yml.
# Never commit a real .env. Generate secrets with: openssl rand -base64 48
NODE_ENV=development

# --- Backend ---
BACKEND_PORT=8000
DATABASE_URL=postgresql://honeypot:honeypot_password@postgres:5432/honeypot
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
JWT_SECRET_KEY=dev-only-change-me-dev-only-change-me
JWT_TTL=1h
# Number of proxy hops to trust for client IPs on the *backend* (e.g. 1 on Render). Never set on sensors.
TRUST_PROXY=false

# Seed accounts (created on first migrate if missing; existing users are never overwritten).
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD=admin123
DASHBOARD_DEMO_USERNAME=demo
DASHBOARD_DEMO_PASSWORD=demo-password

# Sensor ingest tokens: comma-separated sensor_id:token pairs.
HTTP_SENSOR_TOKEN=dev-http-sensor-token
SSH_SENSOR_TOKEN=dev-ssh-sensor-token
# Legacy shared token (POST /attack). Leave empty in production.
HONEYPOT_API_TOKEN=dev-honeypot-token

INGEST_MAX_BATCH=100
INGEST_RATE_LIMIT_PER_MINUTE=1200
API_RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_15MIN=10

# --- Postgres (local container) ---
POSTGRES_DB=honeypot
POSTGRES_USER=honeypot
POSTGRES_PASSWORD=honeypot_password

# --- Sensors ---
SSH_HONEYPOT_PORT=2222
HTTP_HONEYPOT_PORT=8080
# Credentials the fake SSH shell accepts (user:pass,...). Nothing is ever executed.
SSH_ACCEPT_CREDENTIALS=root:123456,root:password,root:root,admin:admin,ubuntu:ubuntu,pi:raspberry,test:test

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Threat-intel enrichment (all optional; a missing key disables that provider) ---
ENRICHMENT_CACHE_TTL_HOURS=24
ABUSEIPDB_API_KEY=
ABUSEIPDB_DAILY_LIMIT=900
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_RATE_PER_MINUTE=4
VIRUSTOTAL_DAILY_LIMIT=450
GREYNOISE_API_KEY=
GREYNOISE_DAILY_LIMIT=25
IPINFO_TOKEN=
# Local MaxMind GeoLite2 databases (preferred: no network, no quota)
GEOIP_CITY_MMDB=
GEOIP_ASN_MMDB=
