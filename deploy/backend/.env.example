# deploy/backend/.env (chmod 600). Generate secrets with: openssl rand -base64 48
POSTGRES_PASSWORD=
# Or use a managed Postgres (Neon/Supabase) instead of the bundled one:
# DATABASE_URL=postgresql://user:pass@host-pooler/db?sslmode=require        (pooled: API)
# DATABASE_URL_UNPOOLED=postgresql://user:pass@host/db?sslmode=require      (direct: migrations + worker)
JWT_SECRET_KEY=
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD=
# Optional read-only demo account (IPs masked, no approvals)
DASHBOARD_DEMO_USERNAME=demo
DASHBOARD_DEMO_PASSWORD=

# One token per sensor: sensor_id:token,...  (same tokens go into deploy/sensor/.env)
SENSOR_TOKENS=oci-ssh-1:REPLACE,oci-http-1:REPLACE

# Your own infrastructure: sensor IP, backend IP, home IP. Never blockable.
NEVER_BLOCK_IPS=

API_DOMAIN=api.example.com
DASHBOARD_DOMAIN=soc.example.com
CORS_ORIGINS=https://soc.example.com
VITE_API_BASE_URL=https://api.example.com
TRUST_PROXY=1

EDL_AUTH_MODE=token
EDL_TOKEN=
# Optional: Prometheus scrape token for GET /admin/metrics?format=prometheus (24+ chars)
METRICS_TOKEN=

# Optional: LLM (any OpenAI-compatible endpoint) and threat intel. Worker only.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
GREYNOISE_API_KEY=
IPINFO_TOKEN=
