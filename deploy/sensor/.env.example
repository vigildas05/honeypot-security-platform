# deploy/sensor/.env on the public sensor VM. chmod 600. Contains ONLY ingest tokens.
# Generate tokens with: openssl rand -base64 36
# Register them on the backend as SENSOR_TOKENS=oci-ssh-1:<ssh token>,oci-http-1:<http token>

SENSOR_INGEST_URL=https://YOUR-BACKEND.example.com/ingest/v1/events
SSH_SENSOR_ID=oci-ssh-1
SSH_SENSOR_TOKEN=
HTTP_SENSOR_ID=oci-http-1
HTTP_SENSOR_TOKEN=

# Images published by CI (Phase 9). Pin a version tag or digest in production.
SSH_SENSOR_IMAGE=ghcr.io/vigildas05/honeypot-ssh-sensor:latest
HTTP_SENSOR_IMAGE=ghcr.io/vigildas05/honeypot-http-sensor:latest

# Optional: credentials the fake shell accepts (default: a small weak list).
SSH_ACCEPT_CREDENTIALS=
SSH_FAKE_HOSTNAME=srv-web-01
