# Running the backend directly (npm run dev / npm run worker) outside Docker.
# For Docker use ../docker-compose.yml (dev) or ../deploy/backend (self-hosted).
NODE_ENV=development
DATABASE_URL=postgresql://honeypot:honeypot_password@localhost:5432/honeypot
JWT_SECRET_KEY=dev-only-change-me-dev-only-change-me
SENSOR_TOKENS=dev-http:dev-http-sensor-token,dev-ssh:dev-ssh-sensor-token
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD=admin123
# Optional (worker): LLM_BASE_URL, LLM_API_KEY, LLM_MODEL, ABUSEIPDB_API_KEY, ... (see ../.env.example)
