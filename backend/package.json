{
  "name": "honeypot-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "user:set": "node src/db/setUser.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
